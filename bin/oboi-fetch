#!/bin/sh
# Запускает oboi_fetch.py. Если рядом лежит собранный oboi-helper (один файл со всеми библиотеками,
# tools/build-helper.sh) и он здесь запускается, берётся он; иначе системный python3.
p=$(readlink -f "$0") && [ -n "$p" ] || { echo "oboi-fetch: не найден путь к себе (нужен readlink -f)" >&2; exit 1; }
d=$(dirname "$p")
h=$d/oboi-helper
if [ -f "$h" ] && [ -x "$h" ]; then
    . "$d/helper-ready.sh"
    # проверенный бинарник запускается вместо обёртки (exec): так Quickshell, гася процесс, гасит его самого
    helper_ready "$h" && exec "$h" fetch "$@"
fi
exec python3 "$d/oboi_fetch.py" "$@"
