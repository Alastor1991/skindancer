#!/bin/sh
# Запускает oboi_semantic.py. Если рядом лежит собранный oboi-helper (один файл со всеми
# библиотеками, tools/build-helper.sh), берётся он, и системный Python не нужен.
p=$(readlink -f "$0") && [ -n "$p" ] || { echo "oboi-semantic: не найден путь к себе (нужен readlink -f)" >&2; exit 1; }
d=$(dirname "$p")
[ -x "$d/oboi-helper" ] && exec "$d/oboi-helper" semantic "$@"
exec python3 "$d/oboi_semantic.py" "$@"
