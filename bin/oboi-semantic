#!/bin/sh
# Запускает oboi_semantic.py. Если рядом лежит собранный oboi-helper (один файл со всеми библиотеками,
# tools/build-helper.sh) и он здесь запускается, берётся он; иначе системный python3.
p=$(readlink -f "$0") && [ -n "$p" ] || { echo "oboi-semantic: не найден путь к себе (нужен readlink -f)" >&2; exit 1; }
d=$(dirname "$p")
h=$d/oboi-helper
if [ -f "$h" ] && [ -x "$h" ]; then
    . "$d/helper-ready.sh"
    if helper_ready "$h"; then
        helper_run "$h" semantic "$@"; rc=$?
        # 126/127: бинарник не запустился (например, выключили nix-ld), тогда Python
        [ $rc -ne 126 ] && [ $rc -ne 127 ] && exit $rc
    fi
fi
exec python3 "$d/oboi_semantic.py" "$@"
