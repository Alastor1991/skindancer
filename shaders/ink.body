// ink: из центра расползается чернильное пятно с рваным краем, у кромки тёмный ободок
void main() {
    vec2 uv = qt_TexCoord0;
    vec2 p = (uv - 0.5) * vec2(aspect, 1.0);
    float ang = atan(p.y, p.x);
    float ragged = fbm(vec2(ang * 2.0 + seed * 7.0, length(p) * 3.0)) * 0.28
                 + fbm(p * 7.0 + seed * 13.0) * 0.10;
    float rmax = length(vec2(aspect, 1.0)) * 0.5 + 0.45;
    float d = length(p) + ragged - progress * rmax;
    float m = (1.0 - smoothstep(-0.008, 0.008, d));
    vec4 c = mix(texture(fromTex, uv), texture(toTex, uv), m);
    float ring = exp(-(d + 0.02) * (d + 0.02) / 0.0009) * (1.0 - smoothstep(0.8, 1.0, progress));
    c.rgb = mix(c.rgb, vec3(0.06, 0.05, 0.08), ring * 0.65);
    fragColor = c * qt_Opacity;
}
