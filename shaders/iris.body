// iris: круг новых обоев раскрывается из центра, по краю тонкая золотая кромка
void main() {
    vec2 uv = qt_TexCoord0;
    vec2 p = (uv - 0.5) * vec2(aspect, 1.0);
    float rmax = length(vec2(aspect, 1.0)) * 0.5 + 0.06;
    float d = length(p) - progress * rmax;
    float m = (1.0 - smoothstep(-0.012, 0.012, d));
    vec4 c = mix(texture(fromTex, uv), texture(toTex, uv), m);
    c.rgb += glow.rgb * rim(d, 0.010) * 0.85;
    fragColor = c * qt_Opacity;
}
