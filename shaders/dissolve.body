// dissolve: старые обои растворяются пятнами шума, граница светится
void main() {
    vec2 uv = qt_TexCoord0;
    // fbm почти весь лежит в 0,25..0,75: растягиваем на 0..1, иначе пятна раскрываются только в середине анимации
    float n = smoothstep(0.22, 0.76, fbm(uv * vec2(aspect, 1.0) * 5.0 + seed * 17.0));
    float t = progress * 1.16 - 0.08;
    float d = n - t;
    float m = (1.0 - smoothstep(-0.02, 0.02, d));
    vec4 c = mix(texture(fromTex, uv), texture(toTex, uv), m);
    c.rgb += glow.rgb * rim(d, 0.018) * 1.1;
    fragColor = c * qt_Opacity;
}
